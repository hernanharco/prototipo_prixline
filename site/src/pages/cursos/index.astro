---
// Catálogo completo de cursos (T10): retícula de tarjetas con jerarquía
// tipográfica (título dominante, meta mínima, sin párrafos) y filtro
// instantáneo en cliente sin dependencias. Progresivo: sin JS la lista
// completa es visible y el campo de filtro queda oculto (clase `js` en
// <html>).
//
// Sin marcos de test de markup en `site/`: la verificación de este módulo
// es el build + `astro check` + greps estructurales sobre `dist/`.
import { getCollection } from 'astro:content';
import { decodeEntities } from '../../lib/format';
import CourseCard from '../../components/CourseCard.astro';
import '../../styles/global.css';

const courses = await getCollection('courses');

// Derivación de meta real del cuerpo del curso (sin inventar datos).
// Verificado sobre los 302 cuerpos del corpus:
//   - Chips: 274 cursos tienen keywords; 28 no (tarjeta sin chips).
//   - Temario: 253 cursos tienen secciones/viñetas; 49 no; 20 no tienen
//     ni chips ni conteo → tarjeta de solo título.
// Reglas (aplicadas a la PRIMERA línea no vacía tras el `# TÍTULO`):
//   - ≥2 partes separadas por comas, sin `:`, sin prosa (sin `. ` ni
//     punto final) y partes cortas (≤50 car.): es patrón de keywords
//     del origen (p. ej. `guitarra, musica, tocar`). En cualquier otro
//     caso → sin chips.
//   - Chips = hasta 3, sin repetidos (insensible a mayúsculas).
//   - Conteo = nº de líneas de sección (Tema/Módulo/Unidad, misma
//     regla que Temario.astro) + viñetas (–, •, -) del cuerpo.
const BULLET_RE = /^[–•-]/;
const SECTION_RE = /^(tema|m[oó]dulo|unidad)/i;

function parseCourseBody(body: string): { chips: string[]; itemCount: number } {
  const lines = body.split(/\r?\n/).map((line) => line.trim());
  // La página renderiza su propio <h1>: descartamos la línea `# ...`.
  let i = 0;
  while (i < lines.length && !lines[i]) i += 1;
  if (lines[i]?.startsWith('#')) {
    i += 1;
    while (i < lines.length && !lines[i]) i += 1;
  }

  const first = lines[i] ?? '';
  const parts = first
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean);
  const isKeywordLine =
    parts.length >= 2 &&
    !first.includes(':') &&
    !/[.]\s/.test(first) &&
    !first.endsWith('.') &&
    parts.every((part) => part.length <= 50);

  const chips: string[] = [];
  if (isKeywordLine) {
    const seen = new Set<string>();
    for (const part of parts) {
      const key = part.toLowerCase();
      if (seen.has(key)) continue;
      seen.add(key);
      chips.push(part);
      if (chips.length === 3) break;
    }
  }

  const itemCount = lines.filter(
    (line) => BULLET_RE.test(line) || SECTION_RE.test(line),
  ).length;

  return { chips, itemCount };
}

// Orden alfabético determinista con ordenación española.
const sorted = courses
  .slice()
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'))
  .map((course) => {
    const title = decodeEntities(course.data.title);
    const { chips, itemCount } = parseCourseBody(course.body ?? '');
    // T9: las tarjetas enlazan a la ficha interna /cursos/<slug>/;
    // el catálogo ya no saca al visitante al blog de origen.
    // Buscable = título + keywords reales: filtrar por "guitarra"
    // funciona aunque esa palabra solo aparezca en la línea de origen.
    const searchText = [title, ...chips].join(' ');
    return {
      title,
      slug: course.data.slug,
      chips,
      itemCount,
      searchText,
    };
  });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cursos — Prixline</title>
    <meta
      name="description"
      content={`Catálogo completo de cursos de Prixline: ${sorted.length} cursos ordenados alfabéticamente.`}
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="catalog-header">
      <div class="container catalog-header__inner">
        <a class="wordmark" href="/">Prixline</a>
        <a class="btn btn--ghost" href="/">Volver al inicio</a>
      </div>
    </header>

    <main id="contenido" class="section">
      <div class="container">
        <p class="eyebrow">Cursos</p>
        <h1>Catálogo de cursos</h1>
        <p class="section-intro">
          Los {sorted.length} cursos de Prixline, ordenados alfabéticamente.
        </p>

        {/* El filtro es mejora progresiva: sin JS queda oculto y la lista
            completa sigue siendo navegable. El contador vive fuera del
            bloque oculto: sin JS sigue mostrando el total real. */}
        <div class="catalog-filter">
          <label class="catalog-filter__label" for="catalog-search">
            Filtrar cursos
          </label>
          <input
            class="catalog-filter__input"
            id="catalog-search"
            type="search"
            placeholder="Escribe un nombre de curso…"
            autocomplete="off"
            data-catalog-filter
          />
        </div>

        <p class="catalog-filter__status" data-filter-status role="status" aria-live="polite">
          {sorted.length} de {sorted.length} cursos
        </p>

        <p class="catalog-empty" data-filter-empty hidden>
          Ningún curso coincide con la búsqueda.
        </p>

        <ul class="catalog-list" data-catalog-list>
          {
            sorted.map((course) => (
              <CourseCard
                title={course.title}
                slug={course.slug}
                chips={course.chips}
                itemCount={course.itemCount}
                searchText={course.searchText}
              />
            ))
          }
        </ul>
      </div>
    </main>

    <script>
      const input = document.querySelector<HTMLInputElement>('[data-catalog-filter]');
      const items = Array.from(
        document.querySelectorAll<HTMLElement>('[data-catalog-list] [data-course]'),
      );
      const status = document.querySelector<HTMLElement>('[data-filter-status]');
      const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
      const EMPTY_TEXT = 'Ningún curso coincide con la búsqueda.';

      if (input && items.length > 0) {
        input.addEventListener('input', () => {
          const query = input.value.trim().toLowerCase();
          let visible = 0;

          for (const item of items) {
            const match = !query || (item.dataset.course ?? '').includes(query);
            item.hidden = !match;
            if (match) visible += 1;
          }

          // Contador en vivo: se actualiza con cada pulsación.
          if (status) status.textContent = `${visible} de ${items.length} cursos`;
          if (empty) {
            empty.hidden = visible !== 0;
            empty.textContent = query
              ? `Ningún curso coincide con «${input.value.trim()}».`
              : EMPTY_TEXT;
          }
        });
      }
    </script>

    <style>
      .catalog-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
      }

      .catalog-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-block: var(--space-3);
      }

      .wordmark {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-navy);
        text-decoration: none;
      }

      html:not(.js) .catalog-filter {
        display: none;
      }

      .catalog-filter {
        margin: var(--space-5) 0 var(--space-2);
      }

      .catalog-filter__label {
        display: block;
        margin-bottom: var(--space-2);
        font-weight: 600;
      }

      .catalog-filter__input {
        width: 100%;
        max-width: 28rem;
        padding: 0.6rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        color: var(--color-text);
        font: inherit;
      }

      .catalog-filter__status {
        margin: 0 0 var(--space-4);
        min-height: 1.2em;
        font-size: var(--text-sm);
        color: var(--color-muted);
      }

      .catalog-empty {
        margin: 0 0 var(--space-4);
        color: var(--color-muted);
      }

      /* Retícula respirable: 1 col. móvil / 2 tablet / 3 escritorio,
         con separación generosa entre tarjetas. */
      .catalog-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-5);
        list-style: none;
        margin: var(--space-5) 0 0;
        padding: 0;
      }

      @media (min-width: 48rem) {
        .catalog-list {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 64rem) {
        .catalog-list {
          grid-template-columns: repeat(3, 1fr);
        }
      }
    </style>
  </body>
</html>
