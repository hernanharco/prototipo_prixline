---
// Home de Prixline. Compone los componentes semánticos sobre el
// contenido REAL importado de `content/` vía las colecciones de Astro y
// los ajustes de `content/settings/*.json`: el singleton `home` aporta
// el copy de las secciones, su ORDEN y su presencia (`enabled`), y el
// singleton `seo` el title/meta de esta página (T4/T6).
import { getCollection } from 'astro:content';
import homeSettings from '../../../content/settings/home.json';
import seoSettings from '../../../content/settings/seo.json';
import socialSettings from '../../../content/settings/social.json';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import LatestArticles from '../components/LatestArticles.astro';
import Courses from '../components/Courses.astro';
import YoutubeChannel from '../components/YoutubeChannel.astro';
import Practices from '../components/Practices.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';

const posts = await getCollection('posts');
const courses = await getCollection('courses');

// 6 artículos más recientes (orden descendente por fecha real).
const latestPosts = posts
  .slice()
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

// Regla de selección de cursos destacados (documentada también en
// Courses.astro): los 9 títulos alfabéticamente primeros con ordenación
// española (localeCompare 'es'). Determinista dada la colección importada.
const featuredCourses = courses
  .slice()
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'))
  .slice(0, 9);

// Año real del artículo más antiguo del archivo.
const earliestYear = posts.length > 0
  ? posts.reduce((min, post) => Math.min(min, post.data.date.getFullYear()), Number.POSITIVE_INFINITY)
  : new Date().getFullYear();

// Orden y presencia de las secciones de la home. Este array es el mapa
// id→componente; el ORDEN real lo manda homeSettings.sectionOrder (CMS)
// y `enabled: false` en el singleton retira la sección del render.
// Hero va siempre primero (fuera del map) y Footer siempre al final.
const sectionDefs = [
  { id: 'trust', Component: Trust },
  { id: 'latest', Component: LatestArticles },
  { id: 'courses', Component: Courses },
  { id: 'youtube', Component: YoutubeChannel },
  { id: 'practices', Component: Practices },
  { id: 'community', Component: Community },
] as const;

const orderedSections = homeSettings.sectionOrder
  .map((id) => sectionDefs.find((section) => section.id === id))
  .filter(
    (section): section is (typeof sectionDefs)[number] =>
      section !== undefined && homeSettings.sections[section.id].enabled !== false,
  );
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoSettings.pages.home.title}</title>
    <meta
      name="description"
      content={seoSettings.pages.home.description}
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <Hero />
      {
        orderedSections.map((section) => {
          if (section.id === 'trust') {
            return (
              <section.Component
                earliestYear={earliestYear}
                postCount={posts.length}
                channelCount={socialSettings.channels.filter((c) => c.platform !== 'sugerencias' && c.platform !== 'opiniones').length}
              />
            );
          }
          if (section.id === 'latest') {
            return <section.Component posts={latestPosts} />;
          }
          if (section.id === 'courses') {
            return <section.Component courses={featuredCourses} totalCourses={courses.length} />;
          }
          return <section.Component />;
        })
      }
    </main>
    <Footer />
  </body>
</html>
