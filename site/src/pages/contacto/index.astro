---
// Página interna de contacto (T15): `/contacto/` construida SOLO con datos
// reales de content/settings/social.json — los canales de comunidad — más
// el enlace a las opiniones (`platform: opiniones`, hilo de comentarios
// real en el sitio de origen). Sin formulario inventado, sin email ni
// teléfono hardcodeados: los datos no los contienen y no se inventan.
// Es el destino del CTA del header y del enlace "Sugerencias" del pie.
// Chips con el mismo estilo que Community.astro (duplicación deliberada:
// extraer lógica compartida no es trivial sin refactorizar el componente).
//
// Chat (decisión del usuario 2026-10-04): el widget de tawk.to de Luis
// (el MISMO chat que usaba en el blog, tomado del cuerpo importado de
// content/pages/contacto.md) se embebe AQUÍ para que el visitante no salga
// de la web. El CTA abre el widget; si el script no carga (bloqueo de red),
// degrada al popout real de tawk.to — nunca a prix.com ni al blog.
import socialSettings from '../../../../content/settings/social.json';
import { getCollection } from 'astro:content';
import { decodeEntities } from '../../lib/format';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const NON_SOCIAL_PLATFORMS = new Set(['sugerencias', 'opiniones']);

// Widget tawk.to de Luis (property id del chat real importado).
const TAWK_PROPERTY_ID = '58f1d6eaf7bbaa72709c64ff';
const TAWK_EMBED_URL = `https://embed.tawk.to/${TAWK_PROPERTY_ID}/default`;
const TAWK_CHAT_URL = `https://tawk.to/chat/${TAWK_PROPERTY_ID}/default`;

// Opiniones (línea secundaria), desde los datos.
const opinionsChannel = socialSettings.channels.find((c) => c.platform === 'opiniones');

// Canales de comunidad reales: 13 entradas − 2 no sociales = 11.
const channels = socialSettings.channels.filter(
  (c) => !NON_SOCIAL_PLATFORMS.has(c.platform),
);

if (!opinionsChannel) {
  throw new Error('social.json debe contener el canal `opiniones`.');
}

// Meta description DERIVADA de los datos (recuento real de canales), no inventada.
const description = `Habla con Prixline por chat y descubre nuestros ${channels.length} canales de comunidad: cursos, prácticas y trabajo en España.`;

// Mapa estático slug → título decodificado para el contexto de curso
// (?curso=<slug> desde /cursos/<slug>/). Los ~302 títulos se inlinean a
// propósito: sitio estático, cero fetch en runtime y el JSON comprimido
// pesa muy poco (pocos KB en gzip). Verificado: slugs únicos en el corpus.
const courses = await getCollection('courses');
const courseTitles: Record<string, string> = {};
for (const course of courses) {
  courseTitles[course.data.slug] = decodeEntities(course.data.title);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contacto — Prixline</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" class="section">
      <div class="container">
        {/* Banner contextual de curso (?curso=<slug>): se desoculta solo con
            JS y un slug válido del mapa estático. Sin JS o sin parámetro,
            queda oculto y la página es la genérica de siempre. */}
        <aside id="curso-context" hidden>
          <p class="curso-context__line">
            Te interesa: <strong id="curso-context-title"></strong>
          </p>
          <a id="curso-context-back">Volver a la ficha del curso</a>
        </aside>

        <nav class="breadcrumb" aria-label="Migas de pan">
          <ol>
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">Contacto</li>
          </ol>
        </nav>

        <p class="eyebrow">Contacto</p>
        <h1>Contacto</h1>
        <p class="section-intro">
          La vía más directa es el chat de Prixline; además estamos presentes
          en {channels.length} canales de comunidad donde publicamos contenido,
          avisos y recursos.
        </p>

        {/* CTA primario: el chat real de Luis (tawk.to, property id
            importado) embebido en esta página — el visitante no sale de la
            web. Fallback: popout real de tawk.to si el widget no carga. */}
        <section class="card contact-chat" aria-labelledby="chat-title">
          <h2 id="chat-title">¿Hablamos?</h2>
          <p class="card__meta">
            Cuéntanos qué necesitas y te ayudamos con cursos, prácticas y tu
            camino en España.
          </p>
          <p class="contact-chat__action">
            <a class="btn btn--accent" id="chat-cta" href={TAWK_CHAT_URL} rel="noopener noreferrer">
              Abrir chat con Prixline
            </a>
          </p>
        </section>

        {/* Canales de comunidad reales (excluye sugerencias/opiniones). */}
        <section class="contact-channels" aria-labelledby="channels-title">
          <h2 id="channels-title">Canales de comunidad</h2>
          <p class="section-intro">
            Sigue a Prixline donde prefieras: vídeo, podcast, audio y redes.
          </p>
          <ul class="chips contact-channels__chips">
            {
              channels.map((channel) => (
                <li>
                  <a class="chip" href={channel.url} rel="noopener noreferrer">
                    <span class="chip__icon" aria-hidden="true">
                      {channel.label.trim().charAt(0).toUpperCase()}
                    </span>
                    {channel.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        {/* Línea secundaria: opiniones reales (comentarios del sitio origen,
            externo legítimo documentado). T24: el dato se muestra como
            TEXTO SIN enlace (misma decisión que el pie, T23) —el hilo vive
            en el blog de origen y no se enlaza fuera—. La etiqueta es la
            del dato. */}
        <p class="contact-opinions">
          ¿Quieres saber qué opinan los alumnos?{' '}
          {opinionsChannel.label}
        </p>
      </div>
    </main>
    <Footer />
  </body>
</html>

<script
  is:inline
  define:vars={{ tawkEmbedUrl: TAWK_EMBED_URL, courseTitles: courseTitles }}
>
  // Widget de tawk.to (mismo chat de Luis). Se carga solo en /contacto/.
  (function () {
    var d = document;

    // Contexto de curso: /contacto/?curso=<slug> llega desde una ficha
    // /cursos/<slug>/. Solo slugs presentes en el mapa estático courseTitles
    // (no hay XSS: el título se asigna con textContent, nunca innerHTML).
    // Sin JS o sin parámetro válido, la página es la genérica de siempre.
    var curso = new URLSearchParams(window.location.search).get('curso');
    var cursoTitulo = curso ? courseTitles[curso] : undefined;
    if (cursoTitulo) {
      var banner = d.getElementById('curso-context');
      var titleEl = d.getElementById('curso-context-title');
      var backEl = d.getElementById('curso-context-back');
      var chatCta = d.getElementById('chat-cta');
      if (banner) banner.hidden = false;
      if (titleEl) titleEl.textContent = cursoTitulo;
      if (backEl) backEl.setAttribute('href', '/cursos/' + curso + '/');
      if (chatCta) chatCta.textContent = 'Abrir chat sobre este curso';

      // Contexto del curso en el dashboard de tawk.to: Tawk_API.onLoad debe
      // definirse ANTES de que se descargue el widget. Best-effort: los
      // fallos de setAttributes son silenciosos.
      window.Tawk_API = window.Tawk_API || {};
      window.Tawk_API.onLoad = function () {
        try {
          window.Tawk_API.setAttributes({ 'Curso consultado': cursoTitulo }, function () {});
        } catch (e) {}
      };
    }

    var s = d.createElement('script');
    s.src = tawkEmbedUrl;
    s.async = true;
    s.charset = 'UTF-8';
    s.setAttribute('crossorigin', '*');
    var x = d.getElementsByTagName('script')[0];
    x.parentNode.insertBefore(s, x);
  })();

  // El CTA abre el widget embebido; si no cargó, el href lleva al popout
  // real de tawk.to (degradación natural sin JS).
  var cta = document.getElementById('chat-cta');
  if (cta) {
    cta.addEventListener('click', function (e) {
      if (window.Tawk_API && typeof window.Tawk_API.toggleChat === 'function') {
        e.preventDefault();
        window.Tawk_API.toggleChat();
      }
    });
  }
</script>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-navy);
    text-decoration: underline;
  }

  .contact-chat {
    max-width: 46rem;
    margin-top: var(--space-6);
  }

  .contact-chat h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .contact-chat__action {
    margin: 0;
  }

  /* Banner contextual de curso (?curso=<slug>): compacto, con los mismos
     tokens que el resto de la página (sin colores nuevos). Sin display
     explícito para no pisar el atributo hidden del UA. */
  .curso-context {
    max-width: 46rem;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .curso-context__line {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
  }

  .curso-context__line strong {
    color: var(--color-text);
  }

  .curso-context__back {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .curso-context__back:hover {
    color: var(--color-gold-ink);
  }

  .contact-channels {
    max-width: 52rem;
    margin-top: var(--space-7);
  }

  /* Mismo chip que Community.astro: inicial de la etiqueta en burbuja. */
  .contact-channels__chips {
    margin-top: var(--space-5);
    gap: var(--space-3);
  }

  .contact-channels__chips .chip {
    padding: 0.4rem 0.9rem;
    font-size: var(--text-sm);
  }

  .contact-opinions {
    max-width: 46rem;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .contact-opinions a {
    color: var(--color-navy);
    text-underline-offset: 2px;
  }

  .contact-opinions a:hover {
    color: var(--color-gold-ink);
  }
</style>
