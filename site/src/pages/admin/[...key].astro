---
// site/src/pages/admin/[...key].astro — T26 + fix post-despliegue (SSR)
//
// Entrada /admin → la UI nativa de Keystatic (inyectada en /keystatic por
// @keystatic/astro@6). Ruta SSR (prerender: false): el middleware de T3
// decide EN CADA PETICIÓN — sin JWT válido → 302 real de servidor a
// /admin/login (antes se prerenderizaba en build y el visitante veía la
// página estática de redirect de Astro, "Redirecting from /admin/ …");
// con JWT válido → esta página reenvía a /keystatic${key}. Los enlaces
// profundos /admin/<x> se resuelven a /keystatic/<x> también en prod.
export const prerender = false;

const key = Astro.params.key ?? '';
const target = `/keystatic${key ? `/${key}` : ''}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Admin — Prixline</title>
  </head>
  <body>
    <p>Abriendo el admin de Keystatic: <a href={target}>{target}</a></p>
  </body>
</html>
