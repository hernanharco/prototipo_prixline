---
// Tarjeta de curso del catálogo `/cursos/` (T10). Jerarquía fuerte y
// mínima: título dominante (máx. 2 líneas) + una única fila de meta
// (nº de elementos de temario y chips de palabras clave derivados del
// cuerpo real). Sin párrafos, sin enlaces de origen, sin metadatos
// inventados. La tarjeta entera es el enlace a la ficha interna.
//
// Props derivadas en `pages/cursos/index.astro` a partir del corpus:
//   - `chips`: hasta 3 keywords de la primera línea del cuerpo (vacío
//     si el cuerpo no sigue ese patrón → no se inventan categorías).
//   - `itemCount`: nº de líneas de sección (Tema/Módulo/Unidad) +
//     viñetas del cuerpo; 0 = sin meta de temario.
interface Props {
  title: string;
  slug: string;
  chips: string[];
  itemCount: number;
  searchText: string;
}

const { title, slug, chips, itemCount, searchText } = Astro.props;
---

<li class="catalog-item" data-course={searchText.toLowerCase()}>
  <a class="course-card" href={`/cursos/${slug}/`}>
    <h3 class="course-card__title">{title}</h3>
    {
      (itemCount > 0 || chips.length > 0) && (
        <div class="course-card__meta">
          {itemCount > 0 && (
            <span class="course-card__count">{itemCount} elementos de temario</span>
          )}
          {chips.length > 0 && (
            <span class="course-card__chips">
              {chips.map((chip) => (
                <span class="chip">{chip}</span>
              ))}
            </span>
          )}
        </div>
      )
    }
  </a>
</li>

<style>
  .catalog-item {
    list-style: none;
  }

  /* Tarjeta-enlace completa: misma caja para todo el área pulsable. */
  .course-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  /* Hover: elevación + acento dorado (borde, título y sombra). */
  .course-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-gold);
    box-shadow:
      0 2px 4px rgba(18, 49, 79, 0.08),
      0 16px 32px rgba(18, 49, 79, 0.12);
  }

  .course-card:hover .course-card__title {
    color: var(--color-gold-ink);
  }

  /* Anillo de foco visible: hereda el :focus-visible global y lo refuerza
     con el acento dorado sobre el borde de la tarjeta. */
  .course-card:focus-visible {
    border-color: var(--color-gold);
  }

  /* Título dominante, máximo 2 líneas (títulos largos no rompen la
     retícula; el texto sigue completo en el DOM y para lectores). */
  .course-card__title {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--color-navy);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* Meta mínima: empujada al pie para alinear filas de la retícula. */
  .course-card__meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .course-card__count {
    white-space: nowrap;
  }

  .course-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .course-card__chips .chip {
    background: var(--color-bg);
  }
</style>
