---
// Últimos artículos: 6 posts más recientes de la colección `posts`, con
// entidades decodificadas, fecha real en <time datetime> y chips de
// categorías. Cada tarjeta enlaza a la ficha interna /articulos/<id>/
// (T13): el visitante permanece en el sitio. El CTA “Ver todos los
// artículos” se re-apunta al índice interno /articulos/ en T14.
// Miniaturas (T11): la imagen vive SIEMPRE en el campo frontmatter
// `thumbnail` (propuesto por el importador, editable desde el CMS); este
// componente no hardcodea ninguna URL. Sin `thumbnail` la tarjeta cae al
// bloque tipográfico (chip + fecha + título), nunca a una imagen rota ni a
// un servicio externo de placeholders.
import type { CollectionEntry } from 'astro:content';
import { decodeEntities, formatDateEs, isoDate } from '../lib/format';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

const ORIGIN_BLOG = 'https://prixline.blog/';
---

<section class="section" id="migracion" aria-labelledby="migracion-title">
  <div class="container">
    <p class="eyebrow">Migración</p>
    <h2 id="migracion-title">Últimos artículos</h2>
    <p class="section-intro">
      Información práctica sobre migrar, formarse y encontrar trabajo, tal y
      como se publicó en el blog de Prixline.
    </p>

    <ul class="cards">
      {
        posts.map((post) => (
          <li>
            <article class="card">
              {post.data.thumbnail && (
                <div class="card__thumb">
                  <img
                    src={post.data.thumbnail}
                    alt={post.data.thumbnailAlt || decodeEntities(post.data.title)}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <p class="card__meta">
                <time datetime={isoDate(post.data.date)}>
                  {formatDateEs(post.data.date)}
                </time>
              </p>
              <h3 class="card__title">
                <a href={`/articulos/${post.id}/`}>
                  {decodeEntities(post.data.title)}
                </a>
              </h3>
              {post.data.categories.length > 0 && (
                <ul class="chips">
                  {post.data.categories.map((category) => (
                    <li class="chip">{category.replace(/-/g, ' ')}</li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        ))
      }
    </ul>

    <p class="cta-row">
      <a class="btn btn--ghost" href={ORIGIN_BLOG}>Ver todos los artículos</a>
    </p>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
  }

  .cards li {
    display: flex;
  }

  .cards .card {
    width: 100%;
  }

  /* Miniatura (T11): marco recortado 16:9 a sangre en la cabecera de la
     tarjeta. object-fit: cover evita deformar; overflow: hidden + radio
     superior heredado recorta la imagen al marco. La URL viene solo de
     frontmatter (regla CMS). */
  .card__thumb {
    aspect-ratio: 16 / 9;
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) 0;
    overflow: hidden;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .card__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-row {
    margin: 0;
  }
</style>
