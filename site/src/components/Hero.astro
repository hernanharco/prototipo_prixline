---
// Hero: promesa de migración responsable + formación en España. El copy
// y los dos CTA salen del singleton home (content/settings/home.json,
// editable desde el CMS); el tagline real sigue viniendo de
// content/settings/site.json.
import siteSettings from '../../../content/settings/site.json';
import homeSettings from '../../../content/settings/home.json';

const hero = homeSettings.hero;
---

<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>
      {hero.heading}
    </h1>
    <p class="hero__tagline">{siteSettings.tagline}</p>
    <p class="hero__sub">
      {hero.subcopy}
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    max-width: calc(var(--container-max) * 0.85);
  }

  .hero h1 {
    max-width: 20ch;
  }

  .hero__tagline {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-gold-ink);
  }

  .hero__sub {
    max-width: 46rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
