---
// Hero: promesa de migración responsable + formación en España, con el
// tagline real de content/settings/site.json y los dos CTA pedidos.
import siteSettings from '../../../content/settings/site.json';
---

<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">Prixline — orientación y formación</p>
    <h1>
      Migra con responsabilidad y prepárate para estudiar y trabajar en España
    </h1>
    <p class="hero__tagline">{siteSettings.tagline}</p>
    <p class="hero__sub">
      Cursos de calidad, apoyo en las prácticas y canales abiertos para que
      des el paso con información real y sin sorpresas.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#migracion">Quiero migrar con responsabilidad</a>
      <a class="btn btn--ghost" href="#cursos">Ver los cursos</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    max-width: calc(var(--container-max) * 0.85);
  }

  .hero h1 {
    max-width: 20ch;
  }

  .hero__tagline {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-gold-ink);
  }

  .hero__sub {
    max-width: 46rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
