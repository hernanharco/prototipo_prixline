---
// T7 — Indicador "EN VIVO" para la sección de YouTube (YoutubeChannel.astro).
// Solo se muestra cuando el canal realmente está emitiendo: el cliente
// consulta la YouTube Data API v3 (search.list con eventType=live). Sin
// `PUBLIC_YOUTUBE_API_KEY` en el build no se hace ninguna petición y el
// badge permanece oculto (hidden + data-state="off").
//
// Cuota YouTube Data API v3 (gratis: 10.000 unidades/día):
//   search.list   → 100 unidades por llamada
//   channels.list →   1 unidad  por llamada (channelId cacheado 24 h en
//                     localStorage — ver site/src/lib/live.ts)
//   300 s serían 288 búsquedas/día = 28.800 u → fuera de cuota.
//   900 s = 96 búsquedas/día = 9.600 u → dentro de cuota.
// El intervalo llega desde content/settings/site.json (generado por
// scripts/import-settings.ts) y queda inlineado como atributo data-*.
interface Props {
  handle: string;
  channelUrl: string;
  checkIntervalSeconds: number;
}

const { handle, channelUrl, checkIntervalSeconds } = Astro.props;
---

<a
  class="live-badge"
  data-live-badge
  data-state="off"
  data-handle={handle}
  data-check-interval-seconds={checkIntervalSeconds}
  href={channelUrl}
  hidden
  role="status"
  aria-live="polite"
>
  <span class="live-badge__dot" aria-hidden="true"></span>
  <span class="live-badge__text">EN VIVO</span>
</a>

<script>
  // T7 — script de módulo (bundled por Vite hacia dist/_astro/*.js).
  // PUBLIC_YOUTUBE_API_KEY queda inlined en build; sin clave, initLiveBadge
  // no hace nada: cero fetch y el badge sigue oculto.
  import { initLiveBadge } from '../lib/live';

  const badge = document.querySelector('[data-live-badge]');
  if (badge instanceof HTMLElement) {
    void initLiveBadge(badge, { apiKey: import.meta.env.PUBLIC_YOUTUBE_API_KEY });
  }
</script>

<style>
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0.25rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-on-navy);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .live-badge:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .live-badge[hidden] {
    display: none !important;
  }

  .live-badge__dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: #e5484d;
    animation: live-badge-pulse 1.6s ease-out infinite;
  }

  .live-badge__text {
    line-height: 1.4;
  }

  @keyframes live-badge-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(229, 72, 77, 0.6);
    }
    70% {
      box-shadow: 0 0 0 0.45em rgba(229, 72, 77, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(229, 72, 77, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-badge__dot {
      animation: none;
    }
  }
</style>
