---
// Pie de página: tagline real, enlace al blog interno /articulos/ (T14),
// sugerencias → página interna /contacto/ (T15), y — desde T23 (exit
// links) — «Opiniones» y «Sitio original» como TEXTO SIN ENLACE para que
// ningún clic del footer salga del sitio.
import siteSettings from '../../../content/settings/site.json';
import socialSettings from '../../../content/settings/social.json';

// T23: `sugerencias` → ruta interna /contacto/; `opiniones` queda como
// texto sin href (el hilo de comentarios vive en el sitio de origen y no
// hay versión interna: decisión del usuario 2026-10-04).
const supportLinks = socialSettings.channels
  .filter((channel) => channel.platform === 'sugerencias' || channel.platform === 'opiniones')
  .map((channel) => ({
    label: channel.label,
    href: channel.platform === 'sugerencias' ? '/contacto/' : null,
  }));

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__wordmark">Prixline</p>
      <p class="site-footer__tagline">{siteSettings.tagline}</p>
    </div>

    <nav aria-label="Enlaces de apoyo">
      <ul class="site-footer__links">
        {/* T14: “Blog” apunta al índice interno /articulos/, no al blog de
            origen. */}
        <li>
          <a href="/articulos/">Blog</a>
        </li>
        {
          supportLinks.map((link) => (
            <li>
              {link.href ? <a href={link.href}>{link.label}</a> : link.label}
            </li>
          ))
        }
        <li>Sitio original de Prixline</li>
      </ul>
    </nav>
  </div>

  <div class="container">
    <p class="site-footer__legal">
      © {year} Prixline. Todos los derechos reservados.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding-block: var(--space-6) var(--space-5);
    background: var(--color-navy);
    color: var(--color-on-navy-muted);
  }

  .site-footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .site-footer__wordmark {
    margin: 0 0 var(--space-1);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-on-navy);
  }

  .site-footer__tagline {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    color: var(--color-on-navy);
  }

  .site-footer a:hover {
    color: var(--color-gold);
  }

  .site-footer__legal {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: var(--text-sm);
  }
</style>
