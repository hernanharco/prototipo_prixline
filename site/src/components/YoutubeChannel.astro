---
// Banda oscura del canal de YouTube. Handle tomado de
// content/settings/site.json (`live.youtubeHandle`). Sin métricas ni
// miniaturas inventadas. El indicador en vivo (T7, LiveBadge.astro) se
// monta aquí: oculto por defecto y solo visible si el canal emite.
import LiveBadge from './LiveBadge.astro';
import siteSettings from '../../../content/settings/site.json';

const handle = siteSettings.live.youtubeHandle;
const channelUrl = `https://youtube.com/${handle.replace(/^@/, '@')}`;
---

<section class="ytband section" aria-labelledby="yt-title">
  <div class="container ytband__inner">
    <div>
      <p class="ytband__eyebrow">Canal de YouTube</p>
      <h2 id="yt-title">Videoclases y charlas de Prixline</h2>
      <p class="ytband__handle">
        Encuéntranos como <strong>{handle}</strong> en YouTube.
      </p>
      <LiveBadge
        handle={handle}
        channelUrl={channelUrl}
        checkIntervalSeconds={siteSettings.live.checkIntervalSeconds}
      />
      <a class="btn btn--on-navy" href={channelUrl}>
        Ver el canal de YouTube
      </a>
    </div>
  </div>
</section>

<style>
  .ytband {
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  .ytband__inner {
    max-width: calc(var(--container-max) * 0.75);
  }

  .ytband :global(h2) {
    color: var(--color-on-navy);
  }

  .ytband__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .ytband__handle {
    color: var(--color-on-navy-muted);
  }
</style>
